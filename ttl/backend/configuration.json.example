    "server_signing_private_key_path": "/home/my-admin-user/.ssh/id_ed25519",
    "server_signing_public_key_path": "/home/my-admin-user/.ssh/id_ed25519.pub",
    "challenge_expiry_minutes": 10,
    "default_member_expiry_days": 365,
