[Unit]
Description=TTL-FRONTEND
After=network-online.target
Wants=network-online.target

[Service]
User=svc-ttl-frontend
Group=svc-ttl-frontend
WorkingDirectory=/srv/ttl-frontend
Environment=DENO_DIR=/srv/deno/.cache
ExecStart=/srv/deno/deno run --allow-net --allow-read --allow-env --allow-write jsr:@std/http/file-server --cert /opt/acme.sh/ttl.harstadmakers.no_ecc/fullchain.cer --key /opt/acme.sh/ttl.harstadmakers.no_ecc/ttl.harstadmakers.no.key --port 443 /srv/ttl-frontend/public
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/ttl-frontend /srv/deno/.cache
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target